{
  "name": "sui-tasks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply sui-db --local",
    "db:remote": "wrangler d1 migrations apply sui-db --remote"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.10.0",
    "idb": "^8.0.3",
    "jose": "^6.1.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20261012.1-beta",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "wrangler": "^4.43.0"
  }
}
